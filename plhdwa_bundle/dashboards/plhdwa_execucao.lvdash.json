{
 "datasets": [
  {
   "name": "janela",
   "displayName": "janela",
   "queryLines": [
    "SELECT (SELECT max(termino_previsto) FROM v_projecao_termino)                                   AS termino_previsto,\n",
    "       (SELECT coalesce(sum(pendentes_qtd), 0) FROM v_projecao_termino)                         AS pendentes_qtd,\n",
    "       (SELECT round(coalesce(sum(pendentes_bytes), 0) / 1073741824, 2) FROM v_projecao_termino) AS pendentes_gb,\n",
    "       (SELECT count(*) FROM v_em_execucao)                                                      AS em_execucao,\n",
    "       -- objetos diferentes em processamento agora (no máximo 1 arquivo por objeto, em qualquer modo)\n",
    "       (SELECT count(DISTINCT cod_objeto) FROM v_em_execucao)                                    AS objetos_em_execucao,\n",
    "       (SELECT count(*) FROM v_lote WHERE status = 'EM_ANDAMENTO')                               AS lotes_em_andamento,\n",
    "       -- foto do último ciclo do despachante (conta também os jobs ainda na fila do Jobs); 0 se não há lote rodando\n",
    "       (SELECT coalesce(max(em_andamento) FILTER (WHERE fila = 'JOB'), 0) FROM log_ciclo_despachante\n",
    "         WHERE ciclo_ts = (SELECT max(ciclo_ts) FROM log_ciclo_despachante)\n",
    "           AND EXISTS (SELECT 1 FROM v_lote WHERE status = 'EM_ANDAMENTO'))                       AS jobs_em_execucao,\n",
    "       (SELECT coalesce(max(em_andamento) FILTER (WHERE fila = 'DESPACHANTE'), 0) FROM log_ciclo_despachante\n",
    "         WHERE ciclo_ts = (SELECT max(ciclo_ts) FROM log_ciclo_despachante)\n",
    "           AND EXISTS (SELECT 1 FROM v_lote WHERE status = 'EM_ANDAMENTO'))                       AS threads_despachante,\n",
    "       (SELECT count(*) FROM v_arquivo_concluido WHERE concluido_em >= current_date())          AS concluidos_hoje,\n",
    "       (SELECT round(coalesce(sum(tamanho_bytes), 0) / 1073741824, 2) FROM v_arquivo_concluido\n",
    "         WHERE concluido_em >= current_date())                                                           AS gb_hoje,\n",
    "       (SELECT coalesce(sum(qtd_inserida), 0) FROM v_arquivo_concluido WHERE concluido_em >= current_date()) AS registros_hoje,\n",
    "       (SELECT count(*) FROM v_objeto_travado)                                                   AS objetos_travados\n"
   ]
  },
  {
   "name": "backlog_fila",
   "displayName": "backlog_fila",
   "queryLines": [
    "SELECT fila AS modo, pendentes_qtd, round(pendentes_bytes / 1048576, 1) AS pendentes_mb, em_andamento, max_simult,\n",
    "       termino_previsto\n",
    "FROM v_projecao_termino\n"
   ]
  },
  {
   "name": "em_execucao",
   "displayName": "em_execucao",
   "queryLines": [
    "SELECT arquivo_ctl, cod_objeto, estado, modo, tipo_job, lote_id, job_run_id, round(tamanho_bytes / 1048576, 1) AS mb,\n",
    "       desde, segundos\n",
    "FROM v_em_execucao\n",
    "ORDER BY desde\n"
   ]
  },
  {
   "name": "objetos_execucao",
   "displayName": "objetos_execucao",
   "queryLines": [
    "-- Um objeto por linha: o arquivo que está rodando agora e quantos arquivos do objeto o lote já concluiu.\n",
    "WITH concluidos AS (\n",
    "  SELECT lote_id, cod_objeto, count(DISTINCT arquivo_ctl) AS concluidos_no_lote\n",
    "  FROM log_carga_evento\n",
    "  WHERE status = 'CONCLUIDO' AND evento_ts >= current_timestamp() - INTERVAL 12 HOURS\n",
    "  GROUP BY 1, 2\n",
    ")\n",
    "SELECT e.cod_objeto, e.tabela_destino, e.modo, e.tipo_job, e.estado, e.arquivo_ctl AS arquivo_atual,\n",
    "       round(e.tamanho_bytes / 1048576, 1) AS mb, e.desde, e.segundos, e.lote_id,\n",
    "       coalesce(c.concluidos_no_lote, 0) AS concluidos_no_lote\n",
    "FROM v_em_execucao e\n",
    "LEFT JOIN concluidos c ON c.lote_id = e.lote_id AND c.cod_objeto = e.cod_objeto\n",
    "ORDER BY e.modo, e.desde\n"
   ]
  },
  {
   "name": "lotes",
   "displayName": "lotes",
   "queryLines": [
    "SELECT lote_id, status, inicio, fim, minutos, pendentes_no_inicio, arquivos_iniciados, arquivos_concluidos,\n",
    "       arquivos_com_erro, concluidos_em_job, registros\n",
    "FROM v_lote\n",
    "WHERE inicio >= date_sub(current_date(), 7)\n",
    "ORDER BY inicio DESC\n",
    "LIMIT 50\n"
   ]
  },
  {
   "name": "ciclos",
   "displayName": "ciclos",
   "queryLines": [
    "SELECT ciclo_ts, fila AS modo, pendentes_qtd, round(pendentes_bytes / 1048576, 1) AS pendentes_mb, em_andamento, max_simult\n",
    "FROM log_ciclo_despachante\n",
    "WHERE ciclo_ts >= date_sub(current_date(), 1)\n"
   ]
  },
  {
   "name": "travados",
   "displayName": "travados",
   "queryLines": [
    "SELECT cod_objeto, erro, arquivo_ctl, left(mensagem, 400) AS mensagem, desde\n",
    "FROM v_objeto_travado\n"
   ]
  },
  {
   "name": "eventos",
   "displayName": "eventos",
   "queryLines": [
    "SELECT evento_ts, cod_objeto, arquivo_ctl, status, fila, tipo_job, tabela_destino, left(mensagem, 300) AS mensagem\n",
    "FROM log_carga_evento\n",
    "WHERE evento_ts >= date_sub(current_date(), 1)\n",
    "ORDER BY evento_ts DESC\n",
    "LIMIT 2000\n"
   ]
  },
  {
   "name": "controle",
   "displayName": "controle",
   "queryLines": [
    "SELECT confirmado_em, cod_objeto, arquivo, status, modo_execucao, lote_id, qtd_registros, dt_inicio, dt_fim,\n",
    "       left(mensagem, 200) AS mensagem\n",
    "FROM db2_controle_sim\n",
    "WHERE confirmado_em >= date_sub(current_date(), 1)\n",
    "ORDER BY confirmado_em DESC\n",
    "LIMIT 1000\n"
   ]
  },
  {
   "name": "desempenho",
   "displayName": "desempenho",
   "queryLines": [
    "SELECT arquivo_ctl, cod_objeto, fila AS modo, coalesce(tipo_job, 'PERFORMANCE_OPTIMIZED') AS tipo_job, lote_id,\n",
    "       round(tamanho_bytes / 1048576, 1)                                         AS tamanho_mb,\n",
    "       unix_timestamp(concluido_em) - unix_timestamp(roteado_em)                 AS duracao_s,\n",
    "       unix_timestamp(fim_carga) - unix_timestamp(inicio_carga)                  AS carga_s,\n",
    "       round(tamanho_bytes / 1073741824 /\n",
    "             greatest(unix_timestamp(concluido_em) - unix_timestamp(roteado_em), 1) * 60, 3) AS gb_por_min,\n",
    "       concluido_em, qtd_inserida\n",
    "FROM v_arquivo_concluido\n",
    "WHERE concluido_em >= date_sub(current_date(), 30)\n"
   ]
  },
  {
   "name": "diario",
   "displayName": "diario",
   "queryLines": [
    "SELECT date(concluido_em) AS dia, count(*) AS arquivos, round(sum(tamanho_bytes) / 1073741824, 3) AS gb,\n",
    "       max(concluido_em) AS ultimo_concluido, sum(qtd_inserida) AS linhas\n",
    "FROM v_arquivo_concluido\n",
    "WHERE concluido_em >= date_sub(current_date(), 30)\n",
    "GROUP BY 1\n"
   ]
  },
  {
   "name": "erros_dia",
   "displayName": "erros_dia",
   "queryLines": [
    "SELECT date(evento_ts) AS dia, status, count(*) AS qtd\n",
    "FROM log_carga_evento\n",
    "WHERE (status LIKE 'ERRO%' OR status = 'ALERTA_FORMATO') AND evento_ts >= date_sub(current_date(), 30)\n",
    "GROUP BY 1, 2\n"
   ]
  },
  {
   "name": "filas",
   "displayName": "filas",
   "queryLines": [
    "SELECT modo, max_simult, job_id_perf, job_id_std, alterado_por, alterado_em\n",
    "FROM ctl_execucao\n",
    "ORDER BY modo\n"
   ]
  }
 ],
